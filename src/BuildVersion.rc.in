#include <winver.h>

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@AE_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Guild Wars 2 Alter Ego Addon\0"
            VALUE "FileVersion", "@AE_FILE_VERSION@\0"
            VALUE "InternalName", "AlterEgo\0"
            VALUE "OriginalFilename", "AlterEgo.dll\0"
            VALUE "ProductName", "Alter Ego\0"
            VALUE "ProductVersion", "@AE_PRODUCT_VERSION@\0"
            VALUE "Comments", "@AE_BUILD_CHANNEL@; build @AE_BUILD_NUMBER@; attempt @AE_BUILD_ATTEMPT@; run @AE_BUILD_RUN_ID@; commit @AE_BUILD_COMMIT@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
